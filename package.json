{
  "name": "insight-agent-platform",
  "private": true,
  "version": "0.1.0",
  "description": "企业经营分析与决策 Agent 平台。",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @insight-agent/web dev -- --host 127.0.0.1 --port 5173",
    "dev:web:open": "pnpm --filter @insight-agent/web dev -- --host 127.0.0.1 --port 5173 --open",
    "dev:backend": "cd services/agent-runtime && uv run uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "debug:web": "python3 -m webbrowser http://localhost:5173",
    "debug:api": "python3 -m webbrowser http://127.0.0.1:8000/docs",
    "debug:health": "curl http://127.0.0.1:8000/health",
    "help:scripts": "node -e \"console.log('dev: 启动前端\\ndev:web: 启动前端\\ndev:web:open: 启动前端并打开浏览器\\ndev:backend: 启动 FastAPI 后端\\ndebug:web: 打开前端页面\\ndebug:api: 打开 FastAPI Swagger Docs\\ndebug:health: 请求 /health\\nverify: 结构和格式检查')\"",
    "check:structure": "node scripts/contracts/check-structure.mjs",
    "check:contracts": "echo \"contracts 结构检查占位\"",
    "verify": "pnpm check:structure && pnpm format:check",
    "format": "prettier --write README.md \"*.{json,mjs}\" \"docs/**/*.md\" \".github/**/*.yml\" \"apps/web/index.html\" \"apps/web/**/*.{json,ts,tsx}\"",
    "format:check": "prettier --check README.md \"*.{json,mjs}\" \"docs/**/*.md\" \".github/**/*.yml\" \"apps/web/index.html\" \"apps/web/**/*.{json,ts,tsx}\"",
    "lint:web": "pnpm --filter @insight-agent/web lint",
    "typecheck:web": "pnpm --filter @insight-agent/web typecheck",
    "test:web": "pnpm --filter @insight-agent/web test",
    "e2e:web": "pnpm --filter @insight-agent/web e2e",
    "lint:backend": "cd services/agent-runtime && uv run ruff check .",
    "format:backend": "cd services/agent-runtime && uv run ruff format .",
    "typecheck:backend": "cd services/agent-runtime && uv run mypy app",
    "test:backend": "cd services/agent-runtime && uv run pytest",
    "smoke": "echo \"smoke 检查占位\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
