# Model provider env template.
# Copy this file to .env.model.local for local development.
# Do not put real API keys in this example file.

IAP_MODEL_ACTIVE_PROVIDER=siliconflow

IAP_MODEL_PROVIDER_SILICONFLOW_API_FORMAT=openai_chat_completions
IAP_MODEL_PROVIDER_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
IAP_MODEL_PROVIDER_SILICONFLOW_CHAT_COMPLETIONS_PATH=/chat/completions
IAP_MODEL_PROVIDER_SILICONFLOW_DEFAULT_MODEL=Qwen/Qwen2.5-7B-Instruct
IAP_MODEL_PROVIDER_SILICONFLOW_API_KEY=

IAP_MODEL_PROVIDER_ZHIPU_API_FORMAT=openai_chat_completions
IAP_MODEL_PROVIDER_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
IAP_MODEL_PROVIDER_ZHIPU_CHAT_COMPLETIONS_PATH=/chat/completions
IAP_MODEL_PROVIDER_ZHIPU_DEFAULT_MODEL=GLM-4.7-Flash
IAP_MODEL_PROVIDER_ZHIPU_API_KEY=

IAP_MODEL_MAX_TOKENS=512
IAP_MODEL_TIMEOUT_MS=30000
IAP_MODEL_TEMPERATURE=0.2
IAP_MODEL_ENABLE_THINKING=false
IAP_MODEL_REAL_API_REQUIRED=true
