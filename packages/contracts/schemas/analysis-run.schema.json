{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight-agent-platform/contracts/analysis-run.schema.json",
  "title": "AnalysisRun",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string"
    },
    "workspaceId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "analysisTaskId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "planning",
        "running",
        "waiting_approval",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "startedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
