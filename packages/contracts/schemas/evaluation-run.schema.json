{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight-agent-platform/contracts/evaluation-run.schema.json",
  "title": "EvaluationRun",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "evaluationRunId": {
      "type": "string"
    },
    "workspaceId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "datasetId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "passed",
        "failed",
        "needs_review"
      ]
    },
    "score": {
      "type": [
        "number",
        "null"
      ]
    },
    "failureReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
