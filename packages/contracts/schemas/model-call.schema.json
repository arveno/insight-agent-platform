{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight-agent-platform/contracts/model-call.schema.json",
  "title": "ModelCall",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "modelCallId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "modelId": {
      "type": "string"
    },
    "promptVersionId": {
      "type": "string"
    },
    "inputTokens": {
      "type": "integer",
      "minimum": 0
    },
    "outputTokens": {
      "type": "integer",
      "minimum": 0
    },
    "cost": {
      "type": "number",
      "minimum": 0
    },
    "latencyMs": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "skipped"
      ]
    },
    "errorType": {
      "type": [
        "string",
        "null"
      ]
    },
    "startedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
