{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight-agent-platform/contracts/memory-item.schema.json",
  "title": "MemoryItem",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "memoryItemId": {
      "type": "string"
    },
    "workspaceId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "memoryType": {
      "type": "string",
      "enum": [
        "user",
        "workspace",
        "analysis",
        "decision"
      ]
    },
    "content": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
