{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight-agent-platform/contracts/workspace.schema.json",
  "title": "Workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspaceId", "name", "createdAt", "updatedAt"],
  "properties": {
    "workspaceId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
