{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://insight-agent-platform/contracts/tool-call.schema.json",
  "title": "ToolCall",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "toolCallId": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "toolName": {
      "type": "string"
    },
    "input": {
      "type": "object"
    },
    "output": {
      "type": [
        "object",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "skipped"
      ]
    },
    "riskLevel": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "permission": {
      "type": "string"
    },
    "errorType": {
      "type": [
        "string",
        "null"
      ]
    },
    "startedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "completedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
