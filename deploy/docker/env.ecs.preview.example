# Example for /opt/insight-agent-platform/env/ecs-preview.env

# Static preview compose project name.
COMPOSE_PROJECT_NAME=iap-ecs-preview

# Preview compose image sources. Preview environments may point REDIS_IMAGE
# to an ACR VPC registry path such as <registry-vpc>/<namespace>/redis:7.
MYSQL_IMAGE=mysql:8
REDIS_IMAGE=redis:7
CADDY_IMAGE=caddy:2
AGENT_RUNTIME_BUILD_CONTEXT=/opt/insight-agent-platform/current
AGENT_RUNTIME_DOCKERFILE=deploy/docker/agent-runtime/Dockerfile
AGENT_RUNTIME_HOST_PORT=8000
AGENT_RUNTIME_PYPI_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
IAP_AGENT_WORKER_POLL_INTERVAL_SECONDS=2
IAP_AGENT_WORKER_IDLE_LOG_INTERVAL_SECONDS=30

# The runtime and worker containers read real model provider env from the
# separate ECS secret file at /opt/insight-agent-platform/env/model-provider.env.

# Only used for ECS host localhost-only MySQL bind so SSH Tunnel / VS Code /
# Navicat / DBeaver can inspect preview data. Never expose this as a public
# port.
MYSQL_HOST_PORT=3306

# Generated on ECS by scripts/deploy/ecs/init-compose-env.sh.
MYSQL_ROOT_PASSWORD=GENERATED_BY_INIT_COMPOSE_ENV
MYSQL_PASSWORD=GENERATED_BY_INIT_COMPOSE_ENV

# Preview foundation defaults shared by agent-runtime and agent-worker.
MYSQL_DATABASE=insight_agent_platform
MYSQL_USER=iap_preview
APP_ENV=preview
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Reserved for later frontend build output deployment. The compose infra
# foundation only mounts the target directory; it does not deploy frontend
# assets in this PR.
CADDY_SITE_ROOT=/opt/insight-agent-platform/shared/frontend

# HTTP preview temporarily keeps the session cookie non-secure. This must be
# changed to true after HTTPS is introduced.
