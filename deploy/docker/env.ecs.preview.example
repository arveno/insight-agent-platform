# Example for /opt/insight-agent-platform/env/ecs-preview.env

# Static preview compose project name.
COMPOSE_PROJECT_NAME=iap-ecs-preview

# Preview compose image sources. Preview environments may point REDIS_IMAGE
# to an ACR VPC registry path such as <registry-vpc>/<namespace>/redis:7.
MYSQL_IMAGE=mysql:8
REDIS_IMAGE=redis:7
CADDY_IMAGE=caddy:2

# Only used for ECS host localhost-only MySQL bind so SSH Tunnel / VS Code /
# Navicat / DBeaver can inspect preview data. Never expose this as a public
# port.
MYSQL_HOST_PORT=3306

# Generated on ECS by scripts/deploy/ecs/init-compose-env.sh.
MYSQL_ROOT_PASSWORD=GENERATED_BY_INIT_COMPOSE_ENV
MYSQL_PASSWORD=GENERATED_BY_INIT_COMPOSE_ENV

# Preview foundation defaults. Later #164 follow-up PRs can adjust these
# values when runtime / worker / migration integration is added.
MYSQL_DATABASE=insight_agent_platform
MYSQL_USER=iap_preview

# Reserved for later frontend build output deployment. The compose infra
# foundation only mounts the target directory; it does not deploy frontend
# assets in this PR.
CADDY_SITE_ROOT=/opt/insight-agent-platform/shared/frontend
